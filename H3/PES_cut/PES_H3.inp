# File: H3_scan_3D.inp

# Using a single point (SP) calculation for a rigid scan
! B3LYP def2-TZVP

%paras
    R = 0.45, 3.05, 53
end

# Ground state doublet
*xyz 0 2
   H   -3.00000   0.000000   0.000000  # Atom 0 (H1)
   H   0.000000   0.000000   0.000000  # Atom 1 (H2)
   H   {R}        0.000000   0.000000  # Atom 2 (H3)
*